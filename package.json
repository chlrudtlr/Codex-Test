{
  "name": "daynote",
  "version": "1.2.0",
  "description": "인터넷 없이 사용하는 업무 및 일정 캘린더",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "author": "ks0108.choi",
  "license": "UNLICENSED",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "node scripts/check.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:mac": "electron-builder --mac dmg",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.daynote.desktop",
    "productName": "Daynote",
    "asar": true,
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": ["electron/**/*", "shared/**/*", "src/**/*", "assets/icon.png", "package.json"],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico",
      "artifactName": "Daynote-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daynote",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["ko_KR", "en_US"],
      "language": "1042"
    },
    "linux": { "target": ["AppImage"], "icon": "assets/icon.png", "category": "Office" },
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity" }
  },
  "dependencies": {
    "exceljs": "4.4.0"
  }
}
